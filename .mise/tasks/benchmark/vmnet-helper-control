#!/usr/bin/env bash
#MISE description="Benchmark krunkit + vmnet-helper offload against the repository-managed libkrun"
#USAGE flag "--streams <streams>" help="Comma-separated parallel iperf3 stream counts" default="1,4,8"
#USAGE flag "--seconds <seconds>" help="Sustained duration per recorded sample" default="20"
#USAGE flag "--warmup-seconds <seconds>" help="Warmup duration per stream count" default="3"
#USAGE flag "--iterations <iterations>" help="Recorded samples per stream count" default="6"
#USAGE flag "--cpus <cpus>" help="krunkit guest vCPU count" default="4"
#USAGE flag "--memory <mib>" help="krunkit guest memory in MiB" default="2048"
#USAGE flag "--timeout <seconds>" help="VM/bootstrap command timeout" default="300"
#USAGE flag "--result-root <dir>" help="Evidence output directory" default="validation-results"

set -euo pipefail

venv="$MISE_PROJECT_ROOT/.build-deps/vmnet-helper-control-venv"
python="${PYTHON:-python3}"

if [[ ! -x "$venv/bin/python" ]]; then
  "$python" -m venv "$venv"
fi
if ! "$venv/bin/python" -c 'import yaml' >/dev/null 2>&1; then
  "$venv/bin/python" -m pip install --disable-pip-version-check 'PyYAML==6.0.3'
fi

exec /usr/bin/caffeinate -i "$venv/bin/python" \
  "$MISE_PROJECT_ROOT/scripts/benchmark_vmnet_helper_control.py" \
  --streams "${usage_streams?}" \
  --seconds "${usage_seconds?}" \
  --warmup-seconds "${usage_warmup_seconds?}" \
  --iterations "${usage_iterations?}" \
  --cpus "${usage_cpus?}" \
  --memory "${usage_memory?}" \
  --timeout "${usage_timeout?}" \
  --result-root "${usage_result_root?}"
