#!/usr/bin/env bash
#MISE description="Benchmark sustained direct TCP throughput at P1/P4/P8 for Apple/VZ and krun runtimes"
#USAGE flag "--runtime-a <runtime>" help="Baseline runtime" default="container-runtime-linux"
#USAGE flag "--runtime-b <runtime>" help="Comparison runtime" default="container-runtime-krun"
#USAGE flag "--network <network>" help="Apple Container network" default="default"
#USAGE flag "--image <image>" help="Python image used for benchmark endpoints" default="python:3.13-alpine"
#USAGE flag "--streams <streams>" help="Comma-separated parallel stream counts" default="1,4,8"
#USAGE flag "--direction <direction>" help="both, guest_to_host, or host_to_guest" default="both"
#USAGE flag "--tcp-info-interval-ms <ms>" help="Guest TCP sampling interval; 0 disables, minimum 100 ms" default="0"
#USAGE flag "--tcp-congestion <algorithm>" help="Guest sender: default, bbr, cubic, or reno" default="default"
#USAGE flag "--seconds <seconds>" help="Sustained duration per recorded sample" default="10"
#USAGE flag "--warmup-seconds <seconds>" help="Warmup duration per runtime/direction/stream count" default="1"
#USAGE flag "--iterations <iterations>" help="A/B -> B/A samples per direction and stream count" default="4"
#USAGE flag "--chunk-kib <kib>" help="TCP sender chunk size in KiB" default="256"
#USAGE flag "--guest-cap-add <caps>" help="Comma-separated Linux capabilities granted to each endpoint, e.g. CAP_NET_ADMIN" default=""
#USAGE flag "--guest-setup <command>" help="Shell command run in each endpoint once ready, e.g. an RPS sysfs write" default=""
#USAGE flag "--timeout <seconds>" help="Command timeout" default="180"
#USAGE flag "--result-root <dir>" help="Evidence output directory" default="validation-results"

set -euo pipefail

extra=()
IFS=',' read -r -a guest_caps <<< "${usage_guest_cap_add:-}"
for capability in ${guest_caps[@]+"${guest_caps[@]}"}; do
  [[ -n "$capability" ]] && extra+=(--guest-cap-add "$capability")
done
if [[ -n "${usage_guest_setup:-}" ]]; then
  extra+=(--guest-setup "${usage_guest_setup}")
fi

exec /usr/bin/caffeinate -i python3 "$MISE_PROJECT_ROOT/scripts/benchmark_network_streams.py" \
  --runtime-a "${usage_runtime_a?}" \
  --runtime-b "${usage_runtime_b?}" \
  --network "${usage_network?}" \
  --image "${usage_image?}" \
  --streams "${usage_streams?}" \
  --direction "${usage_direction?}" \
  --tcp-info-interval-ms "${usage_tcp_info_interval_ms?}" \
  --tcp-congestion "${usage_tcp_congestion?}" \
  --seconds "${usage_seconds?}" \
  --warmup-seconds "${usage_warmup_seconds?}" \
  --iterations "${usage_iterations?}" \
  --chunk-kib "${usage_chunk_kib?}" \
  --timeout "${usage_timeout?}" \
  --result-root "${usage_result_root?}" \
  ${extra[@]+"${extra[@]}"}
